root = Screens([phase1, phase2, phase3, phase4])
phase1 = Screen([badge1, title1, desc1, metric1, metric2, cue1, followups1])
badge1 = Badge("ORBITAL CALIBRATION ACTIVE", "PHASE 01", "info")
