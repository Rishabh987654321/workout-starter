body2 = Text("Engage the simulated harmonic cycle. Synchronize your breathing with the chamber cadence pulse.", "body")
timer2 = Timer("Orbital Synchronization Pulse", 45)
keyw2 = Keyword("4-4-4-4", "Box Breathing Rhythm")
